digraph g {

	s0 [shape="octagon" label=""];
	s1 [shape="circle" label="[a, b]"];
	s2 [shape="circle" label="[c]"];
	s0 -> s1 [modality="MUST" style="" label="1" procedurality="INTERNAL"];
	s0 -> s1 [modality="MAY" style="dashed" label="2" procedurality="INTERNAL"];
	s1 -> s2 [modality="MUST" style="bold" label="3" procedurality="PROCESS"];
	s2 -> s0 [modality="MAY" style="dashed,bold" label="4" procedurality="PROCESS"];

