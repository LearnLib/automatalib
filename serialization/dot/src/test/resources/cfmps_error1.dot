// erroneous CFMPS with multiple main processes

digraph g {

	s0 [shape="octagon" main="true" process="S"];
	s1 [main="true" process="S"];
	s2 [main="true" process="S"];
	s3 [shape="box"final="true" main="true" process="S"];

	s0 -> s1 [label="a"];
	s1 -> s2 [label="T" style="bold" procedurality="PROCESS"];
	s2 -> s3 [label="c"];

	t0 [shape="octagon" main="true" process="T"];
	t1 [shape="box" final="true" main="true" process="T"];

	t0 -> t1 [label="b"];

